# Copy this file to .env and fill in real values. .env is git-ignored.

# --- JWT auth ---
JWT_SECRET=
JWT_VALIDITY=86400

# --- LLM / DashScope (Qwen) ---
LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=
# Mainland China endpoint (default). Use the intl endpoint instead
# (https://dashscope-intl.aliyuncs.com/compatible-mode/v1) if the
# DashScope account/key is provisioned internationally.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_REVIEW_MODEL=qwen3.8-max

# --- MySQL ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=shinshin_curriculum

# --- server ---
PORT=8080
