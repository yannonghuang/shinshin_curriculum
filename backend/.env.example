# Copy this file to .env and fill in real values. .env is git-ignored.

# --- JWT auth ---
JWT_SECRET=
# Seconds of inactivity before a session expires -- a token is reissued with
# a fresh expiry on every user-driven authenticated request (see
# authJwt.js#verifyToken; background polls don't renew it), so this is a
# sliding window, not a fixed session length. 7200 = 2 hours.
JWT_VALIDITY=7200

# --- LLM / DashScope (Qwen) ---
LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=
# Mainland China endpoint (default). Use the intl endpoint instead
# (https://dashscope-intl.aliyuncs.com/compatible-mode/v1) if the
# DashScope account/key is provisioned internationally.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_REVIEW_MODEL=qwen3.8-max
# Vision model 欣欣助手 uses once per uploaded/pasted image, to transcribe and
# describe it as text for the chat model (see copilotAttachments.js).
COPILOT_VISION_MODEL=qwen-vl-max
# true = turn off 欣欣小助手's plan-drafting sub-agent (draft_plan); the main
# assistant then drafts in its own loop, as before the sub-agent existed.
COPILOT_DISABLE_DRAFT_PLAN=

# --- MySQL ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=shinshin_curriculum

# --- server ---
PORT=8080
