# Dev image: install deps (incl. nodemon) only; app code is bind-mounted at
# runtime by docker-compose.yml so edits hot-reload without a rebuild.
FROM node:20-alpine

# node:20-alpine ships unzip (busybox applet) but not zip -- needed by
# artifact.controller.js's zip-download endpoints (downloadByPlan,
# downloadSelection), which shell out to the `zip` binary via child_process.
# mupdf-tools provides `mutool`, used by textExtract.js for PDF text
# extraction (native MuPDF -- far lighter than a JS PDF library; see that
# file's header comment for why).
RUN apk add --no-cache zip mupdf-tools

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

EXPOSE 8080
# docker-entrypoint.sh isn't copied into this image (only package.json is,
# above) -- it arrives via docker-compose.yml's ./backend:/app bind mount,
# already present by the time this entrypoint runs at container start.
ENTRYPOINT ["sh", "docker-entrypoint.sh"]
CMD ["npm", "run", "dev"]
