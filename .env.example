# Copy to .env in the repo root: `cp .env.example .env`, then fill in real
# values. docker compose auto-loads a root .env file for ${VAR} interpolation
# in docker-compose.yml / docker-compose.prod.yml.
#
# This is separate from backend/.env (used only when running the backend
# directly with `npm start`/`npm run dev` outside Docker) and
# react-app/src/config/emailjs.config.js (EmailJS keys, not a compose concern).
# See deploy.md for the full picture.

# --- MySQL ---
DB_ROOT_PASSWORD=changeme-root
DB_NAME=shinshin_curriculum
DB_USER=shinshin
DB_PASSWORD=changeme

# --- JWT auth ---
JWT_SECRET=changeme-generate-a-real-random-secret
JWT_VALIDITY=86400

# --- LLM / DashScope (Qwen) ---
LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_REVIEW_MODEL=qwen3.8-max
