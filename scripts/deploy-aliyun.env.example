# Copy to scripts/deploy-aliyun.env (gitignored, never committed) and fill in
# real values. Used only by scripts/deploy-aliyun.sh, run by hand from your
# own machine -- these credentials never leave your machine, and GitHub never
# sees them (GitHub only ever holds source).

# --- Alibaba Cloud Container Registry (see ALIYUN_DEPLOY.md §1-2) ---
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ACR_NAMESPACE=shinshin
ACR_USERNAME=
ACR_PASSWORD=

# --- Target ECS VM (see ALIYUN_DEPLOY.md §3-4) ---
ECS_HOST=
ECS_USER=root
ECS_SSH_KEY_PATH=~/.ssh/id_ed25519
ECS_DEPLOY_PATH=/opt/shinshin_curriculum
